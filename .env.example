# Voice Integrity Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.

# Required by the orchestrator's content-risk module (Groq LLM API)
GROQ_API_KEY=your-groq-api-key-here

# ─── Google Colab Hybrid Mode (for 8 GB RAM systems) ───
# Run colab_ml_services.py on Google Colab, then paste the ngrok URL here.
# This lets your PC run only lightweight services (~300 MB RAM).
# Example: COLAB_TUNNEL_URL=https://abc123.ngrok-free.app
COLAB_TUNNEL_URL=

# Optional: Your ngrok auth token (free at https://ngrok.com)
# Only needed in the Colab notebook, not locally.
NGROK_AUTH_TOKEN=
