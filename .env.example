# Voice Integrity Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.

# Ollama local LLM URL (used by orchestrator for content-risk analysis)
# Default works for Docker Desktop on Windows/Mac.
# On Linux, use http://host.docker.internal:11434 with extra_hosts in docker-compose.yml.
OLLAMA_URL=http://host.docker.internal:11434
