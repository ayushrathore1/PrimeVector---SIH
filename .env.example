# Voice Integrity Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.

# Ollama local LLM URL (used by orchestrator for content-risk analysis)
# Default for local non-Docker mode is http://localhost:11434
# For Docker mode, use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# ─── Google Colab Hybrid Mode (for 8 GB RAM systems) ───
# Run colab_ml_services.py on Google Colab, then paste the ngrok URL here.
# This lets your PC run only lightweight services (~300 MB RAM).
# Example: COLAB_TUNNEL_URL=https://abc123.ngrok-free.app
COLAB_TUNNEL_URL=

# Optional: Your ngrok auth token (free at https://ngrok.com)
# Only needed in the Colab notebook, not locally.
NGROK_AUTH_TOKEN=

# ─── Dhwani Spoof Dataset Generation (TTS APIs) ───
# Sarvam AI: Indian language TTS (get from dashboard.sarvam.ai, free tier available)
SARVAM_API_KEY=

# ElevenLabs: Multilingual neural TTS (get from elevenlabs.io, 10K chars/month free)
ELEVENLABS_API_KEY=

# ─── Spoof Detection Service ───
# Backend: "deepfake" (default), "dhwani" (Dhwani v1/v2), "heuristic", "stub"
SPOOF_MODEL_REGISTRY_BACKEND=deepfake

